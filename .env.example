# HookLens configuration. Copy to .env and fill in. Never commit .env.
# The backend reads HOOKLENS_* variables (also from this file when run from the repo root).

# ---------------------------------------------------------------- required for Docker
# Random secret (>= 32 chars) that signs anonymous workspace tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
HOOKLENS_WORKSPACE_SECRET=
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- chains
# Ethereum mainnet archive RPC (needed for mainnet scans and mainnet fork simulations).
# Kept server-side only: never sent to the browser, never written into repro commands.
HOOKLENS_MAINNET_RPC_URL=
# Local Anvil chain 31337 with the HookLens fixture hooks.
# true for local development (scripts/dev-chain.sh) or `docker compose --profile dev-chain`.
HOOKLENS_ENABLE_LOCAL_CHAIN=true
# Outside Docker the default is http://127.0.0.1:8545; compose sets http://anvil:8545.
# HOOKLENS_LOCAL_RPC_URL=http://127.0.0.1:8545

# ---------------------------------------------------------------- source verification
# Etherscan v2 API key: enables verified-source fetching (and therefore source-AST analyzers)
# for mainnet hooks. Without it mainnet hooks get permission + bytecode analysis only.
HOOKLENS_ETHERSCAN_API_KEY=

# ---------------------------------------------------------------- AI explanations (optional)
# Without a key, explanations report "unavailable"; everything else works.
HOOKLENS_ANTHROPIC_API_KEY=
HOOKLENS_AI_MODEL=claude-opus-5-5

# ---------------------------------------------------------------- misc
HOOKLENS_CORS_ORIGINS=http://localhost:3000
HOOKLENS_LOG_LEVEL=INFO
# Host port for the web UI in Docker.
HOOKLENS_WEB_PORT=3000
